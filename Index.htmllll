
<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d19">
<title>Dev Universal Remote</title>

<style>
:root {
  --bg:#080d19;
  --panel:#121b2d;
  --line:#26344b;
  --text:#f4f7ff;
  --muted:#9baac2;
  --blue:#4c8dff;
  --green:#42d6a4;
  --red:#ff647c;
}
* { box-sizing:border-box; }
body {
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,sans-serif;
}
header {
  padding:22px 18px;
  background:linear-gradient(135deg,#172d50,#0b1120);
  border-bottom:1px solid var(--line);
}
header h1 { margin:0 0 7px; font-size:24px; }
header p { margin:0;color:var(--muted);font-size:13px; }
main { max-width:650px;margin:auto;padding:16px; }
.tabs {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-bottom:16px;
}
.tab {
  border:1px solid var(--line);
  background:var(--panel);
  color:var(--muted);
  padding:12px 4px;
  border-radius:12px;
  font-weight:bold;
}
.tab.active { color:white;background:#1c3760;border-color:var(--blue); }
.panel {
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:18px;
  padding:18px;
  margin-bottom:14px;
}
h2 { font-size:19px;margin:0 0 8px; }
p.desc { color:var(--muted);font-size:13px;line-height:1.6; }
.status {
  display:flex;align-items:center;gap:9px;
  padding:12px;border-radius:11px;
  background:#0b1322;font-size:13px;
  margin:14px 0;
}
.dot { width:9px;height:9px;border-radius:50%;background:#8592a7; }
button,select,input {
  font:inherit;
}
button {
  cursor:pointer;
  border:1px solid var(--line);
  border-radius:12px;
  padding:13px;
  background:#1a2940;color:white;
}
button:disabled { opacity:.45;cursor:not-allowed; }
.primary { background:var(--blue);border-color:var(--blue); }
.success { background:#123d35;border-color:#267c68; }
.danger { background:#42202c;border-color:#853747; }
.grid {
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;margin-top:15px;
}
.big { min-height:105px;font-size:17px;font-weight:bold; }
.big span { display:block;font-size:28px;margin-bottom:8px; }
.full { width:100%;margin-top:10px; }
label { display:block;font-size:13px;color:var(--muted);margin:12px 0 6px; }
input,select {
  width:100%;padding:12px;border-radius:10px;
  border:1px solid var(--line);background:#0b1322;color:white;
}
.note {
  padding:12px;border-radius:11px;background:#0b1322;
  color:var(--muted);font-size:13px;line-height:1.65;
}
.hidden { display:none; }
#log { white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;color:var(--muted); }
footer { text-align:center;color:var(--muted);font-size:12px;padding:18px; }
</style>
</head>

<body>
<header>
  <h1>⚡ Dev Universal Remote</h1>
  <p>IR Remote • Bluetooth • Car Controller</p>
</header>

<main>
  <div class="tabs">
    <button class="tab active" data-tab="ir">📺 IR Remote</button>
    <button class="tab" data-tab="bt">🔵 Bluetooth</button>
    <button class="tab" data-tab="car">🚘 Car Control</button>
  </div>

  <section id="ir" class="view">
    <div class="panel">
      <h2>📺 Universal IR Remote</h2>
      <p class="desc">
        Compatible IR hardware असलेल्या उपकरणांसाठी.
        हा वेब App फोनचा IR Blaster थेट वापरू शकत नाही.
      </p>

      <label for="deviceType">उपकरण निवडा</label>
      <select id="deviceType">
        <option>TV</option>
        <option>AC</option>
        <option>Set-top box</option>
        <option>इतर IR उपकरण</option>
      </select>

      <div class="grid">
        <button class="big" data-ir="power"><span>⏻</span>Power</button>
        <button class="big" data-ir="mute"><span>🔇</span>Mute</button>
        <button class="big" data-ir="up"><span>＋</span>Volume Up</button>
        <button class="big" data-ir="down"><span>－</span>Volume Down</button>
        <button class="big" data-ir="chup"><span>⌃</span>Channel Up</button>
        <button class="big" data-ir="chdown"><span>⌄</span>Channel Down</button>
      </div>

      <div id="irStatus" class="status">
        <span class="dot"></span>
        IR transmitter जोडलेला नाही
      </div>
      <div class="note">
        ही बटणे सध्या फक्त इंटरफेस आहेत. प्रत्यक्ष IR सिग्नल
        पाठवण्यासाठी सुसंगत transmitter आणि त्याचे API आवश्यक आहे.
      </div>
    </div>
  </section>

  <section id="bt" class="view hidden">
    <div class="panel">
      <h2>🔵 Bluetooth BLE</h2>
      <p class="desc">
        सुसंगत Bluetooth Low Energy डिव्हाइसशी जोडणी करा.
        डिव्हाइसची परवानगी तुम्हाला स्वतः द्यावी लागेल.
      </p>

      <div id="btStatus" class="status">
        <span class="dot"></span>
        Bluetooth तपासलेले नाही
      </div>

      <button id="checkBt" class="full">Bluetooth उपलब्धता तपासा</button>
      <button id="connectBt" class="primary full">डिव्हाइस निवडा व कनेक्ट करा</button>
      <button id="disconnectBt" class="full" disabled>Disconnect</button>

      <h3>डिव्हाइस माहिती</h3>
      <div id="deviceInfo" class="note">अजून कोणतेही डिव्हाइस जोडलेले नाही.</div>

      <button id="inspectBt" class="full" disabled>
        उपलब्ध GATT सेवा पहा (फक्त वाचन)
      </button>
      <div id="services" class="note" style="margin-top:10px">
        सेवा यादी येथे दिसेल.
      </div>
    </div>
  </section>

  <section id="car" class="view hidden">
    <div class="panel">
      <h2>🚘 Car Controller</h2>
      <p class="desc">
        हा विभाग भविष्यातील सुसंगत आणि अधिकृत कार-कंट्रोलर
        जोडणीसाठी आहे.
      </p>

      <div class="status">
        <span class="dot"></span>
        <span id="carStatus">कार कंट्रोलर कॉन्फिगर केलेला नाही</span>
      </div>

      <div class="grid">
        <button class="big" disabled>
          <span>🔒</span>Lock
        </button>
        <button class="big" disabled>
          <span>🔓</span>Unlock
        </button>
      </div>

      <div class="note" style="margin-top:15px">
        <strong>नियंत्रण बंद आहे.</strong><br>
        योग्य कार मॉडेल, अधिकृत API किंवा सुरक्षित हार्डवेअर,
        मालकाची पडताळणी आणि चाचणी होईपर्यंत हे आदेश निष्क्रिय आहेत.
        सामान्य Bluetooth जोडणी म्हणजे कार लॉक नियंत्रित करण्याची
        परवानगी नव्हे.
      </div>

      <h3>आवश्यक माहिती</h3>
      <ul class="desc">
        <li>कारची कंपनी व मॉडेल</li>
        <li>समर्थित लॉक-कंट्रोल इंटरफेस</li>
        <li>अधिकृत कमांड प्रोटोकॉल</li>
        <li>सुरक्षित प्रमाणीकरण व मालकाची परवानगी</li>
      </ul>
    </div>
  </section>

  <section class="panel">
    <h2>📋 App Log</h2>
    <div id="log">App सुरू झाले.</div>
    <button id="clearLog" class="full">Log साफ करा</button>
  </section>
</main>

<footer>
  Dev Universal Remote • Browser-compatible features only
</footer>

<script>
"use strict";

const $ = id => document.getElementById(id);
let btDevice = null;
let btServer = null;

function log(message) {
  const time = new Date().toLocaleTimeString();
  $("log").textContent =
    `[${time}] ${message}\n` + $("log").textContent;
}

function setStatus(id, message, color) {
  const el = $(id);
  el.innerHTML = "";
  const dot = document.createElement("span");
  dot.className = "dot";
  dot.style.background = color || "#8592a7";
  el.append(dot, document.createTextNode(message));
}

document.querySelectorAll(".tab").forEach(button => {
  button.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(b =>
      b.classList.toggle("active", b === button)
    );
    document.querySelectorAll(".view").forEach(section =>
      section.classList.toggle("hidden", section.id !== button.dataset.tab)
    );
  });
});

document.querySelectorAll("[data-ir]").forEach(button => {
  button.addEventListener("click", () => {
    const type = $("deviceType").value;
    const command = button.dataset.ir;
    setStatus("irStatus",
      `${type}: IR transmitter जोडलेला नाही; सिग्नल पाठवला नाही.`,
      "#e7ae50"
    );
    log(`IR demo: ${type}/${command} — सिग्नल पाठवलेला नाही.`);
  });
});

$("checkBt").addEventListener("click", async () => {
  if (!("bluetooth" in navigator)) {
    setStatus("btStatus",
      "या ब्राउझरमध्ये Web Bluetooth उपलब्ध नाही.", "#ff647c");
    log("Web Bluetooth समर्थित नाही.");
    return;
  }

  try {
    const available = await navigator.bluetooth.getAvailability();
    setStatus("btStatus",
      available ? "Bluetooth उपलब्ध असू शकतो." :
      "Bluetooth उपलब्ध नाही किंवा ब्राउझरने प्रवेश रोखला आहे.",
      available ? "#42d6a4" : "#ff647c"
    );
    log("Bluetooth availability: " + available);
  } catch (error) {
    setStatus("btStatus", "Bluetooth तपासता आले नाही.", "#ff647c");
    log("Bluetooth error: " + error.message);
  }
});

$("connectBt").addEventListener("click", async () => {
  if (!window.isSecureContext) {
    log("HTTPS आवश्यक आहे. GitHub Pages HTTPS URL वापरा.");
    setStatus("btStatus", "सुरक्षित HTTPS कनेक्शन आवश्यक.", "#ff647c");
    return;
  }

  if (!navigator.bluetooth) {
    setStatus("btStatus", "या ब्राउझरमध्ये Web Bluetooth समर्थित नाही.",
      "#ff647c");
    return;
  }

  try {
    btDevice = await navigator.bluetooth.requestDevice({
      acceptAllDevices: true,
      optionalServices: []
    });

    setStatus("btStatus",
      "डिव्हाइस निवडले: " + (btDevice.name || "नाव उपलब्ध नाही"),
      "#e7ae50"
    );

    $("deviceInfo").textContent =
      "नाव: " + (btDevice.name || "उपलब्ध नाही") +
      "\nID: " + btDevice.id;

    btDevice.addEventListener("gattserverdisconnected", () => {
      btServer = null;
      $("disconnectBt").disabled = true;
      $("inspectBt").disabled = true;
      setStatus("btStatus", "डिव्हाइस डिस्कनेक्ट झाले.", "#ff647c");
      log("BLE disconnected.");
    });

    // Connect only; no control commands are sent.
    btServer = await btDevice.gatt.connect();

    $("disconnectBt").disabled = false;
    $("inspectBt").disabled = false;

    setStatus("btStatus", "Bluetooth GATT जोडले गेले.", "#42d6a4");
    log("BLE connected: " + (btDevice.name || btDevice.id));
  } catch (error) {
    setStatus("btStatus", "जोडणी झाली नाही: " + error.message, "#ff647c");
    log("BLE connection error: " + error.message);
  }
});

$("disconnectBt").addEventListener("click", () => {
  if (btDevice?.gatt?.connected) btDevice.gatt.disconnect();
});

$("inspectBt").addEventListener("click", async () => {
  if (!btServer?.connected) {
    log("प्रथम BLE डिव्हाइस कनेक्ट करा.");
    return;
  }

  try {
    // No services were requested during pairing.
    // This step only lists services already authorized by the device.
    const services = await btServer.getPrimaryServices();

    $("services").textContent = services.length
      ? services.map(s => "Service UUID: " + s.uuid).join("\n")
      : "डिव्हाइसने उपलब्ध सेवा दिलेल्या नाहीत.";

    log("GATT service list loaded: " + services.length);
  } catch (error) {
    $("services").textContent =
      "सेवा उपलब्ध नाहीत किंवा डिव्हाइसने प्रवेश नाकारला.";
    log("GATT inspection error: " + error.message);
  }
});

$("clearLog").addEventListener("click", () => {
  $("log").textContent = "Log साफ केला.";
});

log("IR interface तयार. BLE compatibility तपासण्यासाठी Bluetooth विभाग उघडा.");
</script>
</body>
</html>
